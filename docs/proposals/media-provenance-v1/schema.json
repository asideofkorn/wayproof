          "required": [
            "id",
            "state",
            "source_id",
            "statement_kind",
            "speaker",
            "text",
            "publication_time",
            "corrects_statement_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "state": {"enum": ["redacted", "removed"]},
            "reason_code": {"enum": ["privacy_removal", "retention_expired", "source_withdrawn"]}
          },
          "required": ["id", "state", "reason_code"],
          "additionalProperties": false
        }
      ]
    },
    "statement_mapping": {
