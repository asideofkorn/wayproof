        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "state": {"enum": ["active"]},
            "statement_id": {"type": "string", "format": "uuid"},
            "mapping_kind": {"enum": ["single", "multiple", "ordered_item", "ambiguous"]},
            "attachment_ids": {
              "type": "array",
              "items": {"type": "string", "format": "uuid"},
              "minItems": 1,
              "uniqueItems": true
            },
            "list_item": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
            "basis": {"type": "string", "minLength": 1},
            "certainty": {"enum": ["explicit", "ambiguous", "unresolved"]}
          },
          "required": ["id", "state", "statement_id", "mapping_kind", "attachment_ids", "list_item", "basis", "certainty"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "state": {"enum": ["redacted", "removed"]},
            "reason_code": {"enum": ["privacy_removal", "retention_expired", "source_withdrawn"]}
          },
          "required": ["id", "state", "reason_code"],
          "additionalProperties": false
        }
      ]
    },
    "analysis_run": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "state": {"enum": ["active"]},
            "source_id": {"type": "string", "minLength": 1},
            "inputs": {"type": "array", "items": {"$ref": "#/$defs/target"}, "minItems": 1, "uniqueItems": true},
