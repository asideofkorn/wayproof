            "source_id",
            "inputs",
            "analyst",
            "method",
            "analysis_time",
            "modalities",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "state": {"enum": ["redacted", "removed"]},
